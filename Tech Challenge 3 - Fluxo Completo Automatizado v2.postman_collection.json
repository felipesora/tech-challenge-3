    {
      "name": "1. Setup (Buscar Tipos de Usuário)",
      "item": [
        {
          "name": "1.1 Buscar Tipos Existentes (Seeder)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "jsonData.forEach(function(item) {",
                  "    if(item.tipo === 'PACIENTE') pm.environment.set('ID_TIPO_PACIENTE', item.id_tipo_usuario);",
                  "    if(item.tipo === 'MEDICO') pm.environment.set('ID_TIPO_MEDICO', item.id_tipo_usuario);",
                  "    if(item.tipo === 'ENFERMEIRO') pm.environment.set('ID_TIPO_ENFERMEIRO', item.id_tipo_usuario);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/tipos-usuario",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "tipos-usuario"
              ]
            }
          },
          "response": []
